parameters:
	level: 8

	paths:
		- src

	excludePaths:
		- src/Configurator.php  # backward compatibility shim

	ignoreErrors:
		-   # ClassLoader is always a user-land class with a file, so getFileName() never returns false
			identifier: argument.type
			message: '#^Parameter \#1 \$\w+ of function (dirname|filemtime) expects string, string\|false given\.$#'
			path: src/Bootstrap/Configurator.php
			count: 2
